<!doctype html>
<html lang="{{ c.lang }}">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>{{ c.meta.title }}</title>
<meta name="description" content="{{ c.meta.description }}">
<meta name="author" content="Ilyes Abd-Lillah">
<meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1">
<link rel="canonical" href="{{ c.url }}">
<link rel="alternate" hreflang="en" href="{{ site }}/">
<link rel="alternate" hreflang="fr" href="{{ site }}/fr/">
<link rel="alternate" hreflang="x-default" href="{{ site }}/">
<meta name="theme-color" content="#0b0c0f">
<meta name="color-scheme" content="dark light">
<meta name="format-detection" content="telephone=no">

<meta property="og:type" content="profile">
<meta property="og:site_name" content="Ilyes Abd-Lillah">
<meta property="og:title" content="{{ c.meta.og_title }}">
<meta property="og:description" content="{{ c.meta.og_description }}">
<meta property="og:url" content="{{ c.url }}">
<meta property="og:locale" content="{{ c.og_locale }}">
<meta property="og:locale:alternate" content="{{ c.og_locale_alt }}">
<meta property="og:image" content="{{ site }}/assets/og/og-{{ c.lang }}.jpg">
<meta property="og:image:secure_url" content="{{ site }}/assets/og/og-{{ c.lang }}.jpg">
<meta property="og:image:type" content="image/jpeg">
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta property="og:image:alt" content="{{ c.meta.og_alt }}">
<meta property="profile:first_name" content="Ilyes">
<meta property="profile:last_name" content="Abd-Lillah">
<meta property="profile:username" content="Ilyomix">
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="{{ c.meta.og_title }}">
<meta name="twitter:description" content="{{ c.meta.og_description }}">
<meta name="twitter:image" content="{{ site }}/assets/og/og-{{ c.lang }}.jpg">
<meta name="twitter:image:alt" content="{{ c.meta.og_alt }}">

<link rel="icon" href="/favicon.ico" sizes="32x32">
<link rel="icon" href="/assets/icons/icon.svg" type="image/svg+xml">
<link rel="apple-touch-icon" href="/assets/icons/apple-touch-icon.png">
<link rel="manifest" href="/site.webmanifest">
<link rel="preload" href="/assets/fonts/instrument-sans.woff2" as="font" type="font/woff2" crossorigin>
<link rel="preload" href="/assets/img/ilyes-portrait.webp" as="image" fetchpriority="high">
<link rel="prefetch" href="/assets/js/gsap.min.js" as="script">
<link rel="me" href="https://github.com/Ilyomix">
<link rel="me" href="https://www.linkedin.com/in/ilyes-abd-lillah">
<style>{{ css }}</style>
<script>(function(d){var r=d.documentElement,t=null,lp=null,ok=true;r.classList.add('js');try{lp=localStorage.getItem('lang')}catch(e){}if(r.lang==='en'&&!lp&&location.pathname==='/'&&/^fr\b/i.test(navigator.language||'')&&!/bot|crawl|spider|lighthouse/i.test(navigator.userAgent)){location.replace('/fr/'+location.hash);return}try{t=localStorage.getItem('theme')}catch(e){}if(t==='light'){r.setAttribute('data-theme','light');d.querySelector('meta[name=theme-color]').setAttribute('content','#f3f2ee')}try{ok=!matchMedia('(prefers-reduced-motion: reduce)').matches}catch(e){}if(ok){r.classList.add('motion-ok','anim');setTimeout(function(){if(!window.__gsapOn){r.classList.remove('anim');r.classList.add('no-anim')}},3500)}else{r.classList.add('reduce')}})(document)</script>
<script type="application/ld+json">{{ jsonld }}</script>
</head>
<body>
<a class="skip" href="#main">{{ c.ui.skip }}</a>

<header class="site-header" id="top">
  <div class="wrap">
    <a class="wordmark" href="{{ c.home }}" aria-label="{{ c.ui.home_label }}"><span class="wordmark-dot" aria-hidden="true"></span>Ilyes Abd-Lillah</a>
    <nav class="nav" aria-label="{{ c.ui.nav_label }}">
      {% for n in c.nav %}<a href="#{{ n.id }}">{{ n.label }}</a>{% endfor %}
    </nav>
    <span class="header-time mono" aria-hidden="true">Toulouse <span data-time>--:--</span></span>
    <button class="theme-toggle" type="button" data-theme-toggle data-label-light="{{ c.ui.to_light }}" data-label-dark="{{ c.ui.to_dark }}" aria-label="{{ c.ui.to_light }}" title="{{ c.ui.to_light }}">
      <svg class="i-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"/></svg>
      <svg class="i-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"/></svg>
    </button>
    <nav class="lang-switch" aria-label="{{ c.ui.lang_label }}">
      <a href="/" hreflang="en" lang="en" data-lang="en"{% if c.lang == 'en' %} aria-current="page"{% endif %}>EN</a>
      <a href="/fr/" hreflang="fr" lang="fr" data-lang="fr"{% if c.lang == 'fr' %} aria-current="page"{% endif %}>FR</a>
    </nav>
  </div>
</header>

<main id="main">
  <section class="hero" aria-labelledby="hero-title">
    <div class="lights hero-lights" aria-hidden="true"><i></i><i></i><i></i><i class="pl" style="--c:var(--l-cobalt);--x:50%;--y:50%;--s:38vmax;--o:.32"></i></div>
    <div class="wrap hero-grid">
      <div class="hero-text">
        <h1 class="hero-title display" id="hero-title">
          <span class="line"><span>Ilyes</span></span>
          <span class="line"><span>Abd-Lillah,</span></span>
          <span class="line role"><span>software &amp;</span></span>
          <span class="line role"><span>design engineer.</span></span>
        </h1>
        <div class="hero-copy">
          <p class="lede">{{ c.hero.lede }}</p>
          <p class="facts mono">{{ c.hero.facts }}</p>
          <div class="actions">
            <a class="btn btn-primary" href="mailto:{{ email }}">{{ icon('mail') }}{{ c.hero.cta_mail }}</a>
            <a class="btn" href="#work">{{ c.hero.cta_work }}{{ icon('down') }}</a>
          </div>
        </div>
      </div>
      <figure class="portrait">
        <span class="portrait-halo" aria-hidden="true"></span>
        <span class="portrait-card">
          <img src="/assets/img/ilyes-portrait.webp" width="368" height="460" alt="{{ c.hero.portrait_alt }}" fetchpriority="high">
          <span class="chip chip-place"><span class="live-dot" aria-hidden="true"></span><span>{{ c.hero.based }}</span><span class="chip-sep" aria-hidden="true">·</span><span class="mono" data-time>--:--</span></span>
          <span class="chip chip-handle">@Ilyomix</span>
        </span>
      </figure>
    </div>
  </section>

  <section class="stage" aria-labelledby="stage-title">
    <div class="stage-pin">
      <div class="spot" aria-hidden="true"></div>
      <div class="lights stage-lights" aria-hidden="true"><i></i><i></i><i></i><i></i><i></i></div>
      <div class="wrap stage-head">
        <h2 class="display stage-title" id="stage-title">{{ c.stage.title }}</h2>
        <p class="lede">{{ c.stage.lede }}</p>
      </div>
      <div class="wrap">
        <div class="set" role="img" aria-label="{{ c.stage.alt }}">
          {% for s in c.stage.devices %}
          <span class="dev dev-{{ s.kind }}{{ ' ' + s.cls if s.cls else '' }}">
            <img src="{{ s.img.src }}" srcset="{{ s.img.srcset }}" sizes="{{ s.img.sizes }}" width="{{ s.img.w }}" height="{{ s.img.h }}" alt="" decoding="async"{% if s.eager %} fetchpriority="low"{% else %} loading="lazy"{% endif %}>
            <span class="screen-off" aria-hidden="true"></span>
          </span>
          {% endfor %}
        </div>
      </div>
      <nav class="wrap legend" aria-label="{{ c.stage.legend_label }}">
        {% for l in c.stage.legend %}<a href="#{{ l.id }}"><img src="{{ l.icon }}" width="28" height="28" alt="" loading="lazy"><span class="legend-text"><span class="fig">Fig.&nbsp;{{ loop.index }}</span> <span>{{ l.name }}</span></span></a>{% endfor %}
      </nav>
    </div>
  </section>

  <section class="section section-rule" id="work" aria-labelledby="work-title">
    <div class="wrap">
      <div class="section-head">
        <h2 class="display h-section" id="work-title" data-reveal>{{ c.work.title }}</h2>
        <p class="lede" data-reveal>{{ c.work.lede }}</p>
      </div>
    </div>

    {% for p in c.projects %}
    <article class="project" id="{{ p.id }}" aria-labelledby="{{ p.id }}-name">
      <div class="lights lit-{{ p.light }}" aria-hidden="true"><i></i><i></i><i></i></div>
      <div class="wrap project-head">
        <div data-reveal>
          <div class="project-name">
            <img class="project-icon" src="{{ p.icon }}" width="60" height="60" alt="" loading="lazy" decoding="async" style="--glow:{{ p.glow }}">
            <h3 class="display h-project" id="{{ p.id }}-name">{{ p.name }}</h3>
          </div>
          <p class="project-tag">{{ p.tagline }}</p>
        </div>
        <div class="project-body" data-reveal>
          {% for para in p.body %}<p>{{ para }}</p>{% endfor %}
          <dl class="specs">
            {% for s in p.specs %}<div><dt>{{ s[0] }}</dt><dd>{{ s[1] }}</dd></div>{% endfor %}
          </dl>
          {% if p.facts %}<p class="facts mono">{{ p.facts }}</p>{% endif %}
          <div class="project-links">
            {% for l in p.links %}<a class="link" href="{{ l.href }}" rel="noopener">{{ l.label }}{{ icon('out') }}</a>{% endfor %}
          </div>
        </div>
      </div>

      <div class="wrap gallery">
      {% if p.id == 'cadran' %}
        <figure class="shot-main" data-reveal><div data-speed="0.4"><img class="device" src="{{ p.media.main.src }}" srcset="{{ p.media.main.srcset }}" sizes="{{ p.media.main.sizes }}" width="{{ p.media.main.w }}" height="{{ p.media.main.h }}" alt="{{ p.media.main.alt }}" loading="lazy" decoding="async"></div></figure>
        <div class="pair">
          {% for m in p.media.pair %}
          <figure data-reveal><img class="device" src="{{ m.src }}" srcset="{{ m.srcset }}" sizes="{{ m.sizes }}" width="{{ m.w }}" height="{{ m.h }}" alt="{{ m.alt }}" loading="lazy" decoding="async"><figcaption class="cap" style="margin-top:14px"><b>{{ m.title }}</b> · {{ m.caption }}</figcaption></figure>
          {% endfor %}
        </div>
        <div class="tiles">
          {% for t in p.media.tiles %}
          <figure class="tile" data-reveal><img src="{{ t.src }}" srcset="{{ t.srcset }}" sizes="{{ t.sizes }}" width="{{ t.w }}" height="{{ t.h }}" alt="{{ t.alt }}" loading="lazy" decoding="async"><figcaption><b>{{ t.title }}</b><br>{{ t.caption }}</figcaption></figure>
          {% endfor %}
        </div>
        <div class="faces" data-reveal>
          <p class="cap"><b>{{ p.media.faces_title }}</b> · {{ p.media.faces_note }}</p>
          <div class="reel-mask">
            <div class="reel-row" data-dir="1">
              {% for copy in [0, 1] %}
              <div class="reel-track"{% if copy %} aria-hidden="true"{% endif %}>
                {% for f in p.media.faces %}<figure><img src="{{ f.src }}" width="560" height="350" alt="{{ '' if copy else f.alt }}" loading="lazy" decoding="async"><figcaption>{{ f.name }}</figcaption></figure>{% endfor %}
              </div>
              {% endfor %}
            </div>
          </div>
        </div>
      {% elif p.id == 'lift' %}
        <div class="phones">
          {% for m in p.media.phones %}
          <figure data-reveal><div data-speed="{{ m.speed }}"><img src="{{ m.src }}" srcset="{{ m.srcset }}" sizes="{{ m.sizes }}" width="{{ m.w }}" height="{{ m.h }}" alt="{{ m.alt }}" loading="lazy" decoding="async"></div><figcaption class="cap"><b>{{ m.title }}</b><br>{{ m.caption }}</figcaption></figure>
          {% endfor %}
        </div>
      {% else %}
        <figure class="led-set" data-reveal>
          <div data-speed="0.3"><img class="device" src="{{ p.media.main.src }}" srcset="{{ p.media.main.srcset }}" sizes="{{ p.media.main.sizes }}" width="{{ p.media.main.w }}" height="{{ p.media.main.h }}" alt="{{ p.media.main.alt }}" loading="lazy" decoding="async"></div>
          <div class="led-phone" data-speed="1.2"><img class="device" src="{{ p.media.phone.src }}" srcset="{{ p.media.phone.srcset }}" sizes="{{ p.media.phone.sizes }}" width="{{ p.media.phone.w }}" height="{{ p.media.phone.h }}" alt="{{ p.media.phone.alt }}" loading="lazy" decoding="async"></div>
        </figure>
        <p class="cap" data-reveal>{{ p.media.caption }}</p>
      {% endif %}
      </div>
    </article>
    {% endfor %}
    <div class="wrap others">
      <h3 class="side-title" data-reveal>{{ c.others.title }}</h3>
      <ul class="others-list">
        {% for o in c.others.list %}
        <li data-reveal>
          <span class="when mono">{{ o.when }}</span>
          <span class="o-name">{% if o.href %}<a href="{{ o.href }}" rel="noopener">{{ o.name }}</a>{% else %}{{ o.name }}{% endif %}</span>
          <span class="o-what">{{ o.what }}</span>
        </li>
        {% endfor %}
      </ul>
    </div>
  </section>

  <section class="numbers-wrap" aria-label="{{ c.numbers.label }}">
    <div class="wrap">
      <div class="numbers" data-reveal>
        {% for n in c.numbers.stats %}<div><b data-count="{{ n.value }}" data-suffix="{{ n.suffix }}">{{ n.display }}</b><span>{{ n.label }}</span></div>{% endfor %}
      </div>
    </div>
  </section>

  <section class="section section-rule" id="recommendations" aria-labelledby="reco-title">
    <div class="lights lit-reco" aria-hidden="true"><i></i><i></i></div>
    <div class="wrap">
      <div class="section-head">
        <h2 class="display h-section" id="reco-title" data-reveal>{{ c.reco.title }}</h2>
        <p class="lede" data-reveal>{{ c.reco.lede }}</p>
      </div>
      <div class="quotes">
        {% for q in c.reco.quotes %}
        <figure class="quote" data-reveal>
          <blockquote lang="{{ q.lang }}"><p>“{{ q.text }}”</p></blockquote>
          <figcaption><b>{{ q.who }}</b><span>{{ q.context }}</span></figcaption>
        </figure>
        {% endfor %}
      </div>
      <p class="reco-more" data-reveal><a class="link" href="https://www.linkedin.com/in/ilyes-abd-lillah" rel="me noopener">{{ c.reco.more }}{{ icon('out') }}</a></p>
    </div>
  </section>

  <section class="section section-rule" id="about" aria-labelledby="about-title">
    <div class="wrap">
      <div class="section-head">
        <h2 class="display h-section" id="about-title" data-reveal>{{ c.about.title }}</h2>
      </div>
      <div class="about-grid">
        <div class="about-text" data-reveal>
          {% for para in c.about.body %}<p>{{ para }}</p>{% endfor %}
        </div>
        <div class="about-side" data-reveal>
          <div>
            <h3 class="side-title">{{ c.about.cares_title }}</h3>
            <ul class="cares">{% for x in c.about.cares %}<li>{{ x }}</li>{% endfor %}</ul>
          </div>
          <div>
            <h3 class="side-title">{{ c.about.lang_title }}</h3>
            <ul class="cares langs">{% for x in c.about.langs %}<li><span>{{ x[0] }}</span><span class="muted">{{ x[1] }}</span></li>{% endfor %}</ul>
          </div>
          <div class="toolbox">
            {% for g in c.about.toolbox %}<div><h3 class="side-title">{{ g.title }}</h3><ul>{% for t in g.list %}<li>{{ t }}</li>{% endfor %}</ul></div>{% endfor %}
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section section-rule" id="experience" aria-labelledby="experience-title">
    <div class="wrap">
      <div class="section-head">
        <h2 class="display h-section" id="experience-title" data-reveal>{{ c.xp.title }}</h2>
        <p class="lede" data-reveal>{{ c.xp.lede }}</p>
      </div>
      <ol class="xp">
        {% for x in c.xp.rows %}
        <li data-reveal>
          <span class="when mono">{{ x.when }}</span>
          <span class="role">{{ x.role }}</span>
          <span class="where">{% if x.href %}<a href="{{ x.href }}" rel="noopener">{{ x.org }}</a>{% else %}{{ x.org }}{% endif %}</span>
        </li>
        {% endfor %}
      </ol>
    </div>
  </section>

  <section class="contact section-rule" id="contact" aria-labelledby="contact-title">
    <div class="lights contact-lights" aria-hidden="true"><i></i><i></i></div>
    <div class="wrap">
      <h2 class="display contact-title" id="contact-title" data-reveal>{{ c.contact.title }}</h2>
      <p class="lede contact-lede" data-reveal>{{ c.contact.lede }}</p>
      <a class="mail" href="mailto:{{ email }}" data-reveal>{{ email }}</a>
      <div class="contact-row" data-reveal>
        <a class="link" href="https://www.linkedin.com/in/ilyes-abd-lillah" rel="me noopener">LinkedIn{{ icon('out') }}</a>
        <a class="link" href="https://github.com/Ilyomix" rel="me noopener">GitHub{{ icon('out') }}</a>
        <a class="link" href="https://www.cadranapp.com" rel="noopener">Cadran{{ icon('out') }}</a>
        <p class="facts mono">{{ c.contact.time_before }}<span data-time>--:--</span>{{ c.contact.time_after }}</p>
      </div>
    </div>
  </section>
</main>

<footer class="site-footer">
  <div class="wrap">
    <p>© {{ year }} Ilyes Abd-Lillah · {{ c.footer.line }}</p>
    <nav class="foot-links" aria-label="{{ c.footer.nav_label }}">
      <a href="https://github.com/Ilyomix" rel="me noopener">GitHub</a>
      <a href="https://www.linkedin.com/in/ilyes-abd-lillah" rel="me noopener">LinkedIn</a>
      <a href="{{ c.alt.href }}" hreflang="{{ c.alt.lang }}" lang="{{ c.alt.lang }}" data-lang="{{ c.alt.lang }}">{{ c.alt.long }}</a>
    </nav>
  </div>
</footer>

<script src="/assets/js/site.js" defer></script>
</body>
</html>
