<!doctype html>
<html lang="{{ lang }}">
<head>
<meta charset="utf-8">
<style>
@font-face { font-family: "Instrument Sans"; src: url("{{ root }}/assets/fonts/instrument-sans.woff2") format("woff2"); font-weight: 400 700; font-stretch: 75% 100%; }
@font-face { font-family: "JetBrains Mono"; src: url("{{ root }}/assets/fonts/jetbrains-mono.woff2") format("woff2"); font-weight: 400 600; }
* { box-sizing: border-box; margin: 0; }
html, body { width: 1200px; height: 630px; overflow: hidden; }
body { background: #0b0c0f; color: #efefec; font-family: "Instrument Sans", sans-serif; position: relative; -webkit-font-smoothing: antialiased; }
.l { position: absolute; border-radius: 50%; }
.l1 { left: -340px; top: -380px; width: 1000px; height: 1000px; background: radial-gradient(closest-side, rgb(65 81 255 / .38), rgb(65 81 255 / .12) 50%, transparent); }
.l2 { right: -200px; top: -40px; width: 820px; height: 820px; background: radial-gradient(closest-side, rgb(255 122 77 / .34), rgb(255 122 77 / .1) 50%, transparent); }

/* Left: who, what, where. Three groups, aligned with the top and bottom of the portrait */
.text { position: absolute; left: 80px; top: 85px; bottom: 85px; width: 620px; display: flex; flex-direction: column; }
.where { display: flex; align-items: center; gap: 12px; font-size: 21px; font-weight: 500; line-height: 1; color: #b9bac0; }
.flag { width: 27px; height: 18px; border-radius: 3.5px; box-shadow: 0 0 0 1px rgb(255 255 255 / .12); }
h1 { margin-top: 24px; font-stretch: 75%; font-weight: 640; letter-spacing: -0.02em; line-height: .86; font-size: 96px; }
h1 span { display: block; }
.role { margin-top: 16px; font-stretch: 75%; font-weight: 600; font-size: 40px; line-height: 1; letter-spacing: -0.012em; color: #95979e; }
.xp { margin-top: 30px; font-size: 22px; line-height: 1.4; color: #efefec; }
.xp span { display: block; color: #95979e; font-size: 19px; }

/* Bottom: the apps, names only */
.apps { margin-top: auto; }
.label { font: 500 14px/1 "JetBrains Mono", monospace; letter-spacing: .02em; color: #7c7e85; }
.row { margin-top: 14px; display: flex; gap: 30px; }
.app { display: flex; align-items: center; gap: 12px; font-size: 20px; font-weight: 620; }
.app img { width: 40px; height: 40px; border-radius: 10px; }

/* Right: the portrait, at its own resolution */
.card { position: absolute; right: 80px; top: 85px; width: 368px; height: 460px; border-radius: 28px; overflow: hidden;
  box-shadow: 0 40px 80px -30px rgb(0 0 0 / .8), 0 0 0 1px rgb(255 255 255 / .14); }
.card img { width: 100%; height: 100%; object-fit: cover; display: block; }
</style>
</head>
<body>
  <div class="l l1"></div><div class="l l2"></div>
  <div class="text">
    <p class="where"><svg class="flag" viewBox="0 0 3 2" aria-hidden="true"><path fill="#0055a4" d="M0 0h1v2H0z"/><path fill="#fff" d="M1 0h1v2H1z"/><path fill="#ef4135" d="M2 0h1v2H2z"/></svg>{{ based }}</p>
    <h1><span>Ilyes</span><span>Abd-Lillah</span></h1>
    <p class="role">Software &amp; design engineer</p>
    <p class="xp">{{ xp.now }}<span>{{ xp.past }}</span></p>
    <div class="apps">
      <p class="label">{{ apps_label }}</p>
      <div class="row">{% for p in products %}<span class="app"><img src="{{ root }}{{ p.icon }}" alt="">{{ p.name }}</span>{% endfor %}</div>
    </div>
  </div>
  <div class="card"><img src="{{ root }}/assets/img/ilyes-portrait.webp" alt=""></div>
</body>
</html>
