<!doctype html>
<html lang="{{ lang }}">
<head>
<meta charset="utf-8">
<style>
@font-face { font-family: "Instrument Sans"; src: url("{{ root }}/assets/fonts/instrument-sans.woff2") format("woff2"); font-weight: 400 700; font-stretch: 75% 100%; }
@font-face { font-family: "JetBrains Mono"; src: url("{{ root }}/assets/fonts/jetbrains-mono.woff2") format("woff2"); font-weight: 400 600; }
* { box-sizing: border-box; margin: 0; }
html, body { width: 1200px; height: 630px; overflow: hidden; }
body { background: #0e0f12; color: #ececea; font-family: "Instrument Sans", sans-serif; position: relative; -webkit-font-smoothing: antialiased; }
.top { position: absolute; left: 64px; right: 64px; top: 52px; display: flex; justify-content: space-between; align-items: center;
       font: 500 19px/1 "JetBrains Mono", monospace; color: #93959c; letter-spacing: -0.01em; }
.site { display: flex; align-items: center; gap: 12px; color: #ececea; }
.dot { width: 12px; height: 12px; border-radius: 3px; background: #4151ff; }
h1 { position: absolute; left: 60px; top: 104px; font-stretch: 75%; font-weight: 640; letter-spacing: -0.018em; line-height: 0.9; font-size: {{ size }}px; }
h1 span { display: block; }
h1 .role { color: #93959c; }
.strip { position: absolute; left: 56px; right: 56px; bottom: 28px; display: grid; grid-template-columns: 1.7fr 0.56fr 0.56fr 1.45fr; gap: 20px; align-items: end; }
.dev { display: block; width: 100%; filter: drop-shadow(0 24px 30px rgb(0 0 0 / .5)); }
.shot { overflow: hidden; }
.shot img { display: block; width: 100%; }
.phone { border-radius: 22px; padding: 4px; background: #000; box-shadow: inset 0 0 0 1px rgb(255 255 255 / .1); margin-bottom: -150px; }
.phone img { border-radius: 18px; }
.fade { position: absolute; left: 0; right: 0; bottom: 0; height: 40px; background: linear-gradient(rgb(14 15 18 / 0), #0e0f12); }
</style>
</head>
<body>
  <div class="top"><span class="site"><span class="dot"></span>ilyomix.github.io</span><span>{{ place }}</span></div>
  <h1><span>Ilyes Abd-Lillah,</span>{% for l in role %}<span class="role">{{ l }}</span>{% endfor %}</h1>
  <div class="strip">
    <img class="dev" src="{{ root }}/assets/img/mac-cadran-desktop-960.webp">
    <div class="shot phone"><img src="{{ root }}/assets/img/lift-home-{{ lang }}-390.webp"></div>
    <div class="shot phone"><img src="{{ root }}/assets/img/lift-session-{{ lang }}-390.webp"></div>
    <img class="dev" src="{{ root }}/assets/img/mac-led-board-960.webp">
  </div>
  <div class="fade"></div>
</body>
</html>
